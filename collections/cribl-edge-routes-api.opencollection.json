          },
          "http": {
            "method": "POST",
            "url": "https://gateway.cribl.cloud/m/:fleetId/routes",
            "params": [
              {
                "name": "fleetId",
                "value": "",
                "type": "path",
                "description": "The edge fleet identifier"
              }
            ],
            "body": {
              "type": "json",
