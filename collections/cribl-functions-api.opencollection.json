{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cribl As Code API Credentials Functions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Functions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List available functions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.cribl.cloud/system/functions"
          },
          "docs": "Retrieves a list of all available processing functions that can be used within pipelines for data transformation, filtering, enrichment, and routing."
        },
        {
          "info": {
            "name": "Get a function by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.cribl.cloud/system/functions/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the resource"
              }
            ]
          },
          "docs": "Retrieves the details of a specific processing function including its configuration schema and description."
        }
      ]
    }
  ],
  "bundled": true
}