{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cribl As Code API Credentials Health API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check management plane health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.cribl.cloud/health"
          },
          "docs": "Returns the health status of the Cribl Cloud management plane services including availability and version information."
        }
      ]
    }
  ],
  "bundled": true
}